{
  "name": "wcl-mcp",
  "version": "0.1.2",
  "description": "MCP server for querying Warcraft Logs data via natural language",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wcl-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "mcp",
    "warcraft-logs",
    "wow",
    "world-of-warcraft",
    "mythic-plus",
    "claude",
    "ai"
  ],
  "author": "Frankie Costoya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vinylflamingo/wcl-mcp"
  },
  "scripts": {
    "build": "tsc && cp -r src/data dist/",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "cli": "node dist/cli.js",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^16.5.0",
    "graphql-request": "^7.1.2",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
